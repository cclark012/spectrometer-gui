+    @staticmethod
+    def _button(layout,text,callback):
+        button=QPushButton(text)
+        button.clicked.connect(lambda _checked=False:callback())
+        if isinstance(layout,QFormLayout):layout.addRow(button)
+        else:layout.addWidget(button)
+        return button
